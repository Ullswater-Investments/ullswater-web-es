---
// Landing page de cada noticia: un .md en src/content/noticias → una página.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fechaLarga } from '../../lib/fecha';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.borrador);
  return noticias.map((n) => ({ params: { slug: n.id }, props: { noticia: n } }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fecha = fechaLarga(noticia.data.fecha);
---
<Base titulo={noticia.data.titulo} descripcion={noticia.data.resumen}>
  <article class="prosa">
    <span class="etiqueta">{noticia.data.programa}</span>
    <h1>{noticia.data.titulo}</h1>
    <p class="fecha">{fecha}</p>
    <p class="entradilla">{noticia.data.resumen}</p>
    <Content />
    <p class="aviso">Fuente: <a href={noticia.data.fuente} rel="noopener">{new URL(noticia.data.fuente).hostname}</a></p>
    <p><a href={`${base}/noticias/`}>← Todas las noticias</a></p>
  </article>
</Base>

<style>
  .fecha { color: var(--texto-2); margin-top: -.5em; }
  .entradilla { font-size: 1.15rem; }
</style>
